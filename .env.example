# =============================================================================
# MEMA Production & Local Environment Variables
# =============================================================================

# 1. Supabase Backend Configuration
# Obtain these from your Supabase Dashboard: Settings -> API
# Supports both modern Publishable keys (sb_publishable_...) and classic anon JWTs
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_..._or_eyJhbGciOi...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 2. Razorpay Payment Gateway (Optional / Production)
# Obtain from your Razorpay Dashboard: Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

