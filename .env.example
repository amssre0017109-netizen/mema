# =========================================================================
# MEMA — Find Your Mood: Supabase, Netlify & Razorpay Environment Variables
# =========================================================================

# 1. Supabase Backend
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Razorpay Payment Gateway
# Your Razorpay Key ID (e.g. rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_mema_student_gateway
